// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums for strict typing
enum UserRole {
  EXAMINER
  CANDIDATE
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AccessType {
  PUBLIC
  PRIVATE
}

enum SubmissionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  MISSED
  PENDING_REVIEW
}

// --------------------------------------------------------
// 1. USER & PROFILE MANAGEMENT
// --------------------------------------------------------
model User {
  id      String   @id @default(cuid())
  clerkId String   @unique // Links to Clerk Authentication
  email   String   @unique
  role    UserRole @default(CANDIDATE)

  // Profile Fields (from Settings Page)
  firstName String?
  lastName  String?
  headline  String? // e.g. "Senior Frontend Developer"
  bio       String? @db.Text
  location  String?
  avatarUrl String?
  resumeUrl String?

  // JSON field for social links to avoid extra tables
  // Structure: { github: string, linkedin: string, website: string }
  socialLinks Json?

  // Relationships
  createdExams Exam[]       @relation("CreatedExams")
  submissions  Submission[] // Exams taken by this user

  assignedExams Exam[] @relation("AllowedCandidates")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------------------------------------------
// 2. EXAMINATION MANAGEMENT
// --------------------------------------------------------
model Exam {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text // Syllabus or Description

  // Settings (from Create Exam Sheet)
  duration    Int        @default(60) // in minutes
  isProctored Boolean    @default(true)
  accessType  AccessType @default(PUBLIC)
  status      ExamStatus @default(DRAFT)

  // Scheduling
  startDate DateTime?
  endDate   DateTime?

  // Private Access Logic
  inviteMessage String? @db.Text // Custom email message for private invites

  // Relationships
  creatorId String
  creator   User   @relation("CreatedExams", fields: [creatorId], references: [id])

  allowedCandidates User[] @relation("AllowedCandidates")

  questions   Question[]
  submissions Submission[]
  invites     ExamInvite[] // List of allowed emails for private exams

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  telemetry TelemetryLog[]
}

model Question {
  id     String @id @default(cuid())
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  text String @db.Text // The actual question generated by AI
  type String // "MCQ", "TEXT", "CODE"

  // For MCQs: ["Option A", "Option B", ...]
  options       Json?
  correctAnswer String? @db.Text

  // AI Complexity Rating
  difficulty String @default("MEDIUM") // EASY, MEDIUM, HARD

  createdAt DateTime @default(now())

  answers Answer[]
}

// --------------------------------------------------------
// 3. RESULTS & AI PROCTORING
// --------------------------------------------------------
model Submission {
  id          String @id @default(cuid())
  examId      String
  exam        Exam   @relation(fields: [examId], references: [id])
  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id])

  status SubmissionStatus @default(SCHEDULED)

  // Performance Metrics
  score Float? // The technical score (e.g., 85.5)
  grade String? // "A", "B", etc.

  // AI Integrity Metrics (The "Truth Score")
  truthScore Float? // 0-100 Integrity rating
  trustLabel String? // "HIGH", "MEDIUM", "LOW"

  // Logs
  startedAt   DateTime?
  submittedAt DateTime?

  // Detailed Proctoring Logs (Tab switches, multiple faces, etc.)
  proctoringEvents ProctoringEvent[]
  answers          Answer[]

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  telemetry TelemetryLog[]
}

model ProctoringEvent {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  type        String // "TAB_SWITCH", "MULTIPLE_FACES", "NO_FACE", "VOICE_DETECTED"
  timestamp   DateTime @default(now())
  evidenceUrl String? // Snapshot image URL if captured
  severity    String // "LOW", "HIGH"
}

model Answer {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  value      String? @db.Text // The candidate's answer
  isCorrect  Boolean @default(false)
  aiFeedback String? @db.Text // AI generated feedback on this specific answer
}

// --------------------------------------------------------
// 4. PRIVATE INVITES
// --------------------------------------------------------
model ExamInvite {
  id     String @id @default(cuid())
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  email  String // The email allowed to take the exam
  status String @default("PENDING") // PENDING, ACCEPTED

  createdAt DateTime @default(now())

  @@unique([examId, email]) // Prevent duplicate invites
}

model TelemetryLog {
  id        String   @id @default(cuid())
  examId    String
  userId    String
  type      String // "SNAPSHOT", "TAB_SWITCH", "FULLSCREEN_EXIT"
  payload   String?  @db.Text // Use @db.Text to store long Base64 strings
  createdAt DateTime @default(now())

  // Relations (Optional but helpful)
  exam Exam @relation(fields: [examId], references: [id])

  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id])
}
